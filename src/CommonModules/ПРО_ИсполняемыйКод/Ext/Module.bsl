// Программный интерфейс для исполняемого кода переопределяемых правил регистрации.
// Методы модуля вызываются из текстов правил, которые хранятся в данных информационной базы,
// поэтому сигнатуры экспортных методов меняются только с сохранением обратной совместимости.

#Область ПрограммныйИнтерфейс

// Заявляет дополнительную регистрацию связанных объектов на текущий узел плана обмена.
// Регистрацию выполняет механизм расширения после кода правила и только если основной объект
// в итоге регистрируется на этот узел (ФильтрПройден = Истина и узел остался в получателях).
// В контексте выгрузки и при удалении объекта заявка не исполняется.
// Не вызывайте ПланыОбмена.ЗарегистрироватьИзменения в коде правила напрямую: код правила
// выполняется в безопасном режиме без привилегий, а транзакция вокруг него может быть отменена.
//
// Параметры:
//  ДополнительнаяРегистрация - Соответствие - переменная контекста правила, передается как есть.
//  Ссылки - ЛюбаяСсылка, Массив из ЛюбаяСсылка, ФиксированныйМассив из ЛюбаяСсылка - объекты для регистрации.
//           Неопределено, Null и пустые ссылки пропускаются.
//  ТолькоНевыгруженные - Булево - Истина: регистрировать только объекты, которые еще не отправлялись
//           на узел и не сопоставлялись с ним (нет публичного идентификатора для узла).
//
// Пример:
//  ПРО_ИсполняемыйКод.ЗарегистрироватьСвязанные(ДополнительнаяРегистрация, Файлы, Истина);
//
Процедура ЗарегистрироватьСвязанные(ДополнительнаяРегистрация, Ссылки, ТолькоНевыгруженные = Ложь) Экспорт
	
	ПроверитьДополнительнуюРегистрацию(ДополнительнаяРегистрация);
	
	Если ТипЗнч(ТолькоНевыгруженные) <> Тип("Булево") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'ПРО: параметр ТолькоНевыгруженные должен быть типа Булево, передано: %1 (%2).'"),
			ТолькоНевыгруженные, ТипЗнч(ТолькоНевыгруженные));
	КонецЕсли;
	
	Если ТипЗнч(Ссылки) = Тип("Массив") Или ТипЗнч(Ссылки) = Тип("ФиксированныйМассив") Тогда
		КоллекцияСсылок = Ссылки;
	Иначе
		КоллекцияСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылки);
	КонецЕсли;
	
	Для Каждого Ссылка Из КоллекцияСсылок Цикл
	
		Если Ссылка = Неопределено Или Ссылка = Null Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка)) Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'ПРО: в ЗарегистрироватьСвязанные передано значение не ссылочного типа: %1 (%2).'"),
				Ссылка, ТипЗнч(Ссылка));
		КонецЕсли;
		
		Если Ссылка.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДополнительнаяРегистрация[Ссылка] <> Ложь Тогда
			ДополнительнаяРегистрация.Вставить(Ссылка, ТолькоНевыгруженные);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Вызывает исключение, если код правила заменил переменную ДополнительнаяРегистрация другим значением.
//
// Параметры:
//  ДополнительнаяРегистрация - Произвольный - проверяемое значение.
//
Процедура ПроверитьДополнительнуюРегистрацию(ДополнительнаяРегистрация) Экспорт
	
	Если ТипЗнч(ДополнительнаяРегистрация) <> Тип("Соответствие") Тогда
		ВызватьИсключение НСтр("ru = 'ПРО: параметр ДополнительнаяРегистрация должен быть переменной контекста правила.
		                             |Не присваивайте ей других значений, заполняйте через ПРО_ИсполняемыйКод.ЗарегистрироватьСвязанные.'");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
